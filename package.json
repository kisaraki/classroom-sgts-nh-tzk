{
  "name": "classroom-sgts-nh-tzk",
  "version": "0.0.0",
  "private": true,
  "description": "Storm Genesis: Northern Hemisphere Typhoon Simulator",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:scenario": "node -e \"console.log('Phase 2: scenario tests not applicable')\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test:unit && npm run test:integration && npm run test:scenario && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "eslint": "10.8.0"
  },
  "license": "MIT"
}
